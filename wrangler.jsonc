{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lindairiane",
  "main": "worker.js",
  "compatibility_date": "2026-08-01",

  // wrangler lo ejecuta solo antes de `dev` y de `deploy`, así que dist/ nunca
  // se queda viejo y Cloudflare puede construir el sitio sin más configuración.
  "build": {
    "command": "node build/build.mjs && node build/check.mjs"
  },

  // La web entera es estática: dist/ lo genera build/build.mjs. Workers Builds hace
  // el npm install solo (sharp).
  // Las peticiones a estos ficheros no pasan por el Worker y son gratis e
  // ilimitadas; el Worker solo se ejecuta para /api/contacto.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },

  // Enviar a una dirección verificada en Email Routing no consume cuota en
  // ningún plan. El formulario solo escribe a Linda, así que sale gratis.
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "lindairianescort@gmail.com"
    }
  ],

  "vars": {
    "REMITENTE": "web@lindaporn.com",
    "DESTINO": "lindairianescort@gmail.com"
  },

  "observability": {
    "enabled": true
  }
}
